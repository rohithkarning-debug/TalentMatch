# Copy this file to .env.local and replace the placeholders with your own values.
# .env.local is gitignored — never commit real credentials.

# Used by docker-compose.yml to create the database container
POSTGRES_USER=talentmatch
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_DB=talentmatch
POSTGRES_PORT=5433

# Used by the Next.js app (must match the values above)
DATABASE_URL=postgresql://talentmatch:replace_with_a_strong_database_password@localhost:5433/talentmatch

# Authentication (Stage 3)
# Secret used to sign session JWTs. Must be at least 32 characters, random,
# and different for every environment. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
# Optional: session lifetime in seconds (default 28800 = 8 hours, allowed 300-604800)
# AUTH_SESSION_MAX_AGE_SECONDS=28800
